<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- 카메라 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Skeleton -->
    <com.beodysseus.poseprototype.PoseOverlayView
        android:id="@+id/poseOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 상단 상태 -->
    <TextView
        android:id="@+id/userStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="#D9111827"
        android:paddingLeft="18dp"
        android:paddingTop="12dp"
        android:paddingRight="18dp"
        android:paddingBottom="12dp"
        android:text="사용자를 화면 중앙에 위치해주세요."
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/pairingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="#E6111827"
        android:orientation="horizontal"
        android:padding="12dp">

        <EditText
            android:id="@+id/pairingCodeEditText"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:hint="4자리 코드"
            android:inputType="number"
            android:maxLength="4"
            android:textColor="#111827"
            android:textColorHint="#6B7280"
            android:textSize="18sp" />

        <Button
            android:id="@+id/pairingButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:text="연결" />

        <TextView
            android:id="@+id/pairingStatusText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:text="연결 대기"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- 오른쪽 자세 분석 패널 -->
    <LinearLayout
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="24dp"
        android:background="#E6111827"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="자세 분석"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="실시간 자세 측정"
            android:textColor="#9CA3AF"
            android:textSize="14sp" />

        <!-- 상체 -->
        <TextView
            android:id="@+id/bodyLeanText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#263244"
            android:padding="16dp"
            android:text="상체 기울기: --"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <!-- 활팔 -->
        <TextView
            android:id="@+id/bowArmText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#263244"
            android:padding="16dp"
            android:text="활팔 기준 오차: --"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />



        <Button
            android:id="@+id/retryUserButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="처음부터 다시"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 하단 상태 -->
    <TextView
        android:id="@+id/stageStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:background="#D9111827"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:text="USER 01  ·  STAGE 준비"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</FrameLayout>