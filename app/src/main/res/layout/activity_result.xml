<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF3FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 상단 제목 바 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#243E73"
            android:gravity="center_vertical"
            android:paddingStart="32dp"
            android:text="양궁 자세 분석 결과"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 메인 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="24dp"
            android:weightSum="3">

            <!-- 왼쪽 : 분석 완료 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="260dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏹"
                    android:textSize="58sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="자세 분석 완료"
                    android:textColor="#172554"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="3개 Stage의 자세 분석이\n완료되었습니다."
                    android:textColor="#64748B"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- 가운데 : 종합 점수 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="260dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="종합 자세 점수"
                    android:textColor="#172554"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overallScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="--점"
                    android:textColor="#0369A1"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/starScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="☆☆☆☆☆"
                    android:textColor="#F59E0B"
                    android:textSize="30sp" />

            </LinearLayout>

            <!-- 오른쪽 : 항목별 평가 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="260dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="항목별 평가"
                    android:textColor="#172554"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bodyScoreText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="• 상체 자세                 --"
                    android:textColor="#334155"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bowArmScoreText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="• 활팔 펴짐                 --"
                    android:textColor="#334155"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/drawArmScoreText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="• 양팔 정렬                 --"
                    android:textColor="#334155"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Stage 결과 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/stage1ScoreText"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:gravity="center"
                android:text="STAGE 1\n--점"
                android:textColor="#334155"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stage2ScoreText"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:gravity="center"
                android:text="STAGE 2\n--점"
                android:textColor="#334155"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stage3ScoreText"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:gravity="center"
                android:text="STAGE 3\n--점"
                android:textColor="#334155"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 결과 코멘트 -->
        <TextView
            android:id="@+id/resultCommentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:background="#DCE7F5"
            android:gravity="center"
            android:padding="16dp"
            android:text="자세 분석이 완료되었습니다."
            android:textColor="#334155"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>